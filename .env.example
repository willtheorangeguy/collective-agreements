DATABASE_URL=postgres://collective:collective@localhost:5433/collective
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3000

AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=llama3.1

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=agreements
S3_ACCESS_KEY=collectivedev
S3_SECRET_KEY=collectivedevsecret
S3_FORCE_PATH_STYLE=true

REBUILD_WEBHOOK_URL=

PUBLIC_API_URL=http://localhost:3000
PUBLIC_SITE_NAME=Collective Agreements
# Public origin of the static site. Required in production: it produces canonical
# URLs, sitemap.xml and changes.xml, and must also be listed in WEB_ORIGIN below.
PUBLIC_SITE_URL=http://localhost:4321

# Comma-separated browser origins allowed to call the API with credentials.
# localhost is allowed automatically unless NODE_ENV=production.
WEB_ORIGIN=
