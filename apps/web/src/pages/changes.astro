---
import Base from "../layouts/Base.astro";
---

<Base
  title="Recent changes"
  description="Every published edit to the collective agreements library, newest first."
>
  <h1 class="text-3xl font-bold">Recent changes</h1>
  <p class="mt-2 max-w-2xl text-stone-600">
    Every published revision, newest first — AI analyses of new submissions and corrections made
    by the community. Spot something wrong? Open the page and fix it.
  </p>

  <div class="mt-6 flex flex-wrap gap-2 text-sm">
    <button data-filter="all" class="chip rounded-full border border-stone-900 bg-stone-900 px-3 py-1 text-white">All</button>
    <button data-filter="community" class="chip rounded-full border border-stone-300 bg-white px-3 py-1 hover:bg-stone-100">Community edits</button>
    <button data-filter="ai" class="chip rounded-full border border-stone-300 bg-white px-3 py-1 hover:bg-stone-100">New AI analyses</button>
  </div>

  <div id="feed" class="mt-6">
    <p class="text-stone-500">Loading…</p>
  </div>

  <script>
    import { esc, fmtDateTime } from "../scripts/dom.js";

    const feed = document.getElementById("feed")!;

    interface Change {
      id: string;
      slug: string;
      title: string;
      isAi: boolean;
      editSummary: string | null;
      createdAt: string;
      editorName: string | null;
    }

    let all: Change[] = [];
    let filter: "all" | "community" | "ai" = "all";

    function render(): void {
      const items = all.filter((c) =>
        filter === "all" ? true : filter === "ai" ? c.isAi : !c.isAi,
      );
      if (items.length === 0) {
        feed.innerHTML = '<p class="text-stone-500">Nothing to show yet.</p>';
        return;
      }
      feed.innerHTML = `<ul class="space-y-2">${items
        .map(
          (c) => `
          <li class="rounded-lg border border-stone-200 bg-white p-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <a href="/agreements/${encodeURIComponent(c.slug)}" class="font-medium hover:underline">${esc(c.title)}</a>
              <span class="text-xs text-stone-500">${fmtDateTime(c.createdAt)}</span>
            </div>
            <p class="mt-1 text-sm text-stone-600">
              <span class="rounded px-1.5 py-0.5 text-xs font-medium ${
                c.isAi ? "bg-amber-100 text-amber-900" : "bg-blue-100 text-blue-900"
              }">${c.isAi ? "AI analysis" : "community edit"}</span>
              ${c.editorName ? ` by ${esc(c.editorName)}` : ""}
              ${c.editSummary ? ` — ${esc(c.editSummary)}` : ""}
            </p>
            <p class="mt-1 text-xs">
              <a href="/history/?slug=${encodeURIComponent(c.slug)}" class="text-blue-700 hover:underline">view history</a>
            </p>
          </li>`,
        )
        .join("")}</ul>`;
    }

    for (const btn of Array.from(document.querySelectorAll<HTMLButtonElement>(".chip"))) {
      btn.addEventListener("click", () => {
        filter = btn.dataset.filter as typeof filter;
        for (const b of Array.from(document.querySelectorAll<HTMLButtonElement>(".chip"))) {
          const active = b === btn;
          b.className = `chip rounded-full border px-3 py-1 ${
            active
              ? "border-stone-900 bg-stone-900 text-white"
              : "border-stone-300 bg-white hover:bg-stone-100"
          }`;
        }
        render();
      });
    }

    async function load(): Promise<void> {
      try {
        const res = await fetch(`${window.__API__}/agreements/feed/changes?limit=100`);
        if (!res.ok) throw new Error();
        all = ((await res.json()) as { items: Change[] }).items;
        render();
      } catch {
        feed.innerHTML = '<p class="text-red-700">Could not reach the API.</p>';
      }
    }

    void load();
  </script>
</Base>
