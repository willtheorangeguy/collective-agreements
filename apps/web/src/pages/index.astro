---
import Base from "../layouts/Base.astro";
---

<Base title="Collective Agreements">
  <section class="py-12 text-center">
    <h1 class="text-4xl font-bold tracking-tight">Union collective agreements, open to everyone</h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-stone-600">
      A public library of collective bargaining agreements from around the world. Submit an
      agreement, an AI produces a structured summary, and the community verifies every detail.
    </p>

    <form action="/agreements/" method="get" class="mx-auto mt-8 flex max-w-xl gap-2">
      <label for="home-q" class="sr-only">Search agreements</label>
      <input
        id="home-q"
        name="q"
        type="search"
        placeholder="Search wages, leave, a union name, a sector…"
        class="min-w-0 flex-1 rounded border border-stone-300 bg-white px-4 py-2.5"
      />
      <button type="submit" class="rounded bg-stone-900 px-5 py-2.5 font-medium text-white hover:bg-stone-700">
        Search
      </button>
    </form>

    <div class="mt-4 flex justify-center gap-3 text-sm">
      <a href="/agreements/" class="underline">Browse everything</a>
      <span class="text-stone-300">·</span>
      <a href="/submit" class="underline">Submit an agreement</a>
      <span class="text-stone-300">·</span>
      <a href="/changes" class="underline">Recent changes</a>
    </div>

    <dl id="stats" class="mx-auto mt-10 grid max-w-2xl grid-cols-2 gap-4 sm:grid-cols-4"></dl>
  </section>

  <section class="grid gap-4 py-8 md:grid-cols-3">
    <div class="rounded-lg border border-stone-200 bg-white p-6">
      <div class="text-sm font-semibold text-stone-500">1 · Submit</div>
      <p class="mt-2 text-stone-700">Upload a PDF or paste the text of any publicly available collective agreement.</p>
    </div>
    <div class="rounded-lg border border-stone-200 bg-white p-6">
      <div class="text-sm font-semibold text-stone-500">2 · AI analysis</div>
      <p class="mt-2 text-stone-700">An AI model extracts parties, dates, wages, hours, leave, grievance rules and more.</p>
    </div>
    <div class="rounded-lg border border-stone-200 bg-white p-6">
      <div class="text-sm font-semibold text-stone-500">3 · Community verification</div>
      <p class="mt-2 text-stone-700">Anyone can correct errors. Edits are reviewed and versioned, Wikipedia-style.</p>
    </div>
  </section>

  <section class="py-4">
    <div class="flex items-baseline justify-between">
      <h2 class="text-xl font-semibold">Recently added and edited</h2>
      <a href="/changes" class="text-sm underline">All changes</a>
    </div>
    <div id="recent" class="mt-3">
      <p class="text-sm text-stone-500">Loading…</p>
    </div>
  </section>

  <section class="mt-8 rounded-lg border border-amber-300 bg-amber-50 p-6 text-amber-900">
    <h2 class="font-semibold">How to read these pages</h2>
    <p class="mt-2 text-sm">
      Every agreement page shows AI-generated content until community editors have verified it.
      AI sections are always labelled. Nothing on this site is legal advice — when in doubt,
      consult the linked original document.
    </p>
  </section>

  <script>
    import { esc, fmtDateTime } from "../scripts/dom.js";

    const statsEl = document.getElementById("stats")!;
    const recentEl = document.getElementById("recent")!;

    function tile(value: number, label: string): string {
      return `
        <div class="rounded-lg border border-stone-200 bg-white p-4">
          <dt class="text-xs uppercase tracking-wide text-stone-500">${label}</dt>
          <dd class="mt-1 text-2xl font-bold tabular-nums">${value.toLocaleString()}</dd>
        </div>`;
    }

    async function loadStats(): Promise<void> {
      try {
        const res = await fetch(`${window.__API__}/agreements/stats`);
        if (!res.ok) throw new Error();
        const s = (await res.json()) as {
          agreements: number;
          countries: number;
          communityEdits: number;
          pendingEdits: number;
        };
        statsEl.innerHTML =
          tile(s.agreements, "Agreements") +
          tile(s.countries, "Countries") +
          tile(s.communityEdits, "Community edits") +
          tile(s.pendingEdits, "Awaiting review");
      } catch {
        statsEl.innerHTML = "";
      }
    }

    async function loadRecent(): Promise<void> {
      try {
        const res = await fetch(`${window.__API__}/agreements/feed/changes?limit=6`);
        if (!res.ok) throw new Error();
        const items = ((await res.json()) as {
          items: { slug: string; title: string; isAi: boolean; createdAt: string }[];
        }).items;
        if (items.length === 0) {
          recentEl.innerHTML =
            '<p class="text-sm text-stone-500">Nothing yet — <a href="/submit" class="underline">be the first to submit</a>.</p>';
          return;
        }
        recentEl.innerHTML = `<ul class="divide-y divide-stone-200 rounded-lg border border-stone-200 bg-white">${items
          .map(
            (i) => `
            <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-3">
              <a href="/agreements/${encodeURIComponent(i.slug)}" class="font-medium hover:underline">${esc(i.title)}</a>
              <span class="text-xs text-stone-500">${i.isAi ? "new analysis" : "edited"} · ${fmtDateTime(i.createdAt)}</span>
            </li>`,
          )
          .join("")}</ul>`;
      } catch {
        recentEl.innerHTML = '<p class="text-sm text-stone-500">Could not reach the API.</p>';
      }
    }

    void loadStats();
    void loadRecent();
  </script>
</Base>
