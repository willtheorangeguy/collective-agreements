---
import Base from "../../layouts/Base.astro";
---

<Base title="Analysis in progress" noindex={true}>
  <div class="mx-auto max-w-xl py-12 text-center">
    <h1 class="text-3xl font-bold">Analysing your submission</h1>
    <p class="mt-3 text-stone-600">
      The AI is reading the document and extracting parties, dates and provisions. This usually
      takes a minute or two. The page appears in the library as soon as it is done.
    </p>

    <div id="state" class="mt-8 rounded-lg border border-stone-200 bg-white p-6">
      <p class="text-stone-700">Checking status…</p>
    </div>

    <p class="mt-6 text-sm text-stone-500">
      You can safely close this tab — progress is also shown under
      <a href="/dashboard/me" class="underline">My activity</a>.
    </p>
  </div>

  <script>
    import { esc } from "../../scripts/dom.js";

    const box = document.getElementById("state")!;
    const slug = new URLSearchParams(location.search).get("slug") ?? "";

    // The site is statically generated: a page for a brand new agreement does not
    // exist until the next rebuild, so poll the API and redirect once it lands.
    const START = Date.now();
    const GIVE_UP_AFTER_MS = 10 * 60 * 1000;
    let delay = 3000;

    function render(html: string): void {
      box.innerHTML = html;
    }

    async function poll(): Promise<void> {
      if (!slug) {
        render('<p class="text-stone-700">No submission specified.</p>');
        return;
      }
      try {
        const res = await fetch(`${window.__API__}/agreements/${encodeURIComponent(slug)}/status`);
        if (res.status === 404) {
          render('<p class="text-red-700">That submission could not be found.</p>');
          return;
        }
        const data = (await res.json()) as { status: string };

        if (data.status === "published") {
          render(`
            <p class="font-medium text-green-800">Analysis complete.</p>
            <a href="/agreements/${esc(slug)}"
              class="mt-4 inline-block rounded bg-stone-900 px-5 py-2.5 font-medium text-white hover:bg-stone-700">
              Open the agreement page
            </a>
            <p class="mt-3 text-xs text-stone-500">
              If the link 404s, the static site has not rebuilt yet — try again shortly.
            </p>`);
          return;
        }
        if (data.status === "failed") {
          render(`
            <p class="font-medium text-red-700">Analysis failed.</p>
            <p class="mt-2 text-sm text-stone-600">
              The document could not be read — a scanned PDF without a text layer is the usual
              cause. Try pasting the text instead, or
              <a href="/about" class="underline">get in touch</a>.
            </p>`);
          return;
        }
        if (data.status === "rejected") {
          render('<p class="font-medium text-red-700">This submission was removed by a moderator.</p>');
          return;
        }

        const secs = Math.round((Date.now() - START) / 1000);
        render(`
          <p class="text-stone-700">Still processing… <span class="text-stone-400">(${secs}s)</span></p>
          <div class="mx-auto mt-4 h-1.5 w-48 overflow-hidden rounded bg-stone-200">
            <div class="h-full w-1/3 animate-pulse rounded bg-stone-500"></div>
          </div>`);
      } catch {
        render('<p class="text-red-700">Could not reach the API.</p>');
      }

      if (Date.now() - START > GIVE_UP_AFTER_MS) {
        render(`
          <p class="text-stone-700">This is taking longer than usual.</p>
          <p class="mt-2 text-sm text-stone-500">
            Check <a href="/dashboard/me" class="underline">My activity</a> later — the worker may
            be backed up or offline.
          </p>`);
        return;
      }
      delay = Math.min(delay * 1.4, 20000); // back off; analysis can take a while
      setTimeout(poll, delay);
    }

    void poll();
  </script>
</Base>
